. ${ROOT_DIR}/${KERNEL_DIR}/build.config.constants

KMI_GENERATION=11

LLVM=1
DEPMOD=depmod
CLANG_PREBUILT_BIN=prebuilts/clang/host/linux-x86/clang-${CLANG_VERSION}/bin
# caihong: the clang 22 of the Android tree, as passed to bazel by
# build_with_bazel.py (--user_clang_toolchain)
CLANG_PREBUILT_BIN=../prebuilts/clang/host/linux-x86/clang-r584948/bin
BUILDTOOLS_PREBUILT_BIN=build/kernel/build-tools/path/linux-x86
DTC=${ROOT_DIR}/${BUILDTOOLS_PREBUILT_BIN}/dtc

KCFLAGS="${KCFLAGS} -D__ANDROID_COMMON_KERNEL__"
# caihong: schedule for the Cortex-A720 cores, which run most kernel work on
# this SoC, use a larger inliner budget and run Polly loop optimizations in
# the ThinLTO backend (the linker, where LTO code generation runs).
KCFLAGS="${KCFLAGS} -mtune=cortex-a720 -mllvm -inline-threshold=350"
KLDFLAGS="${KLDFLAGS} -mllvm -polly -mllvm -polly-ast-use-context -mllvm -polly-invariant-load-hoisting -mllvm -polly-loopfusion-greedy -mllvm -polly-run-inliner -mllvm -polly-run-dce -mllvm -inline-threshold=350"
EXTRA_CMDS=''
STOP_SHIP_TRACEPRINTK=1
IN_KERNEL_MODULES=1
DO_NOT_STRIP_MODULES=1

HERMETIC_TOOLCHAIN=${HERMETIC_TOOLCHAIN:-1}
