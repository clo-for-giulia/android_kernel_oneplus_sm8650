# OnePlus Pad 2 (caihong) only. Listed after the common fragments in
# device/oneplus/caihong/BoardConfig.mk, so other sm8650 devices are not affected.

# LMH DCVS: votes the isense reference supplies of the CPU limits hardware
# (pineapple-thermal.dtsi qcom,msm-hw-limits). Stock OPD2403 loads msm_lmh_dcvs.ko.
CONFIG_QTI_THERMAL_LIMITS_DCVS=m
